{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview-ro": {
      "env": {
        "APP_VARIANT": "ro",
        "EXPO_PUBLIC_CHAT_URL": "https://elenka-chat.elenka-chat.workers.dev"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production-ios": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_CHAT_URL": "https://elenka-chat.elenka-chat.workers.dev"
      },
      "ios": {
        "resourceClass": "default"
      }
    }
  },
  "submit": {
    "production-ios": {
      "ios": {}
    }
  }
}
