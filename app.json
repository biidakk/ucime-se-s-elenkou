{
  "expo": {
    "name": "Elenka",
    "slug": "czech-lang-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biidakk.ucimeseselenkou",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "Elenka",
        "NSPhotoLibraryUsageDescription": "Aplikace k fotkám nepřistupuje. Apple tento text vyžaduje kvůli knihovně pro práci se soubory.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E5AA8",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.biidakk.ucimeseselenkou"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Učíme se s Elenkou",
      "shortName": "Elenka",
      "lang": "cs",
      "themeColor": "#1E5AA8",
      "backgroundColor": "#F6F8FB"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-speech-recognition"
    ],
    "scheme": "jazyky",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/ucime-se-s-elenkou"
    },
    "extra": {
      "eas": {
        "projectId": "428bff1e-af7e-4ed4-b85c-1132a3122fd0"
      }
    },
    "owner": "biidakk"
  }
}
