      "tip": {
        "title": "Wir haben gekocht",
        "text": "Minulý čas se v němčině většinou skládá ze dvou částí: haben + příčestí. Pozor: česky řekneme „jsme vařili“, německy ale „wir haben gekocht“ (doslova „máme vařeno“). Příčestí se tvoří ge- … -t: machen → gemacht, kochen → gekocht, putzen → geputzt. A stojí vždy na konci věty: Wir haben gestern Kartoffeln gekocht. Některá slovesa mají příčestí nepravidelné (waschen → gewaschen) nebo bez ge- (besuchen → besucht).",
        "examples": [
          { "target": "Wir haben gestern Kartoffeln gekocht.", "native": "Včera jsme vařili brambory." },
          { "target": "Anna hat am Wochenende die Wohnung geputzt.", "native": "Anna o víkendu uklízela byt." },
          { "target": "Wir haben Freunde besucht.", "native": "Navštívili jsme přátele." }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u10-l1-w1", "target": "das Wochenende", "native": "víkend", "note": "am Wochenende = o víkendu; množné číslo: die Wochenenden", "reviewed": false },
