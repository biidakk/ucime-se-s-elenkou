    {
      "id": "u18-l3",
      "title": "Domácí práce",
      "titleTarget": "Hausarbeit",
      "reviewed": false,
      "tip": {
        "title": "Räum auf! = Ukliď!",
        "text": "Když dáváte pokyn někomu, komu tykáte, vezměte tvar pro du a odstraňte du i koncovku -st: du räumst auf → Räum auf! (Ukliď!), du kochst → Koch! Předpona jde i tady na konec. Slovesa, která mění e na i nebo ie, to dělají i v rozkazu: du nimmst → Nimm!, du liest → Lies! Přehláska z a na ä ale zmizí: du wäschst ab → Wasch ab!, du fährst → Fahr! Aby pokyn nezněl příkře, přidejte bitte: Räum bitte auf! Občas uslyšíte i tvar s -e: Räume auf!",
        "examples": [
          { "target": "Räum bitte das Zimmer auf!", "native": "Ukliď si prosím pokoj!" },
          { "target": "Wasch bitte ab!", "native": "Umyj prosím nádobí!" },
          { "target": "Bring bitte den Müll raus!", "native": "Vynes prosím odpadky!" }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u18-l3-w1", "target": "aufräumen", "native": "uklidit; dát do pořádku", "note": "Dát věci na místo; putzen = čistit, mýt. Ich räume auf.", "reviewed": false },
        { "id": "u18-l3-w2", "target": "abwaschen", "native": "mýt nádobí", "note": "du wäschst ab, er wäscht ab; rozkaz: Wasch ab!", "reviewed": false },
        { "id": "u18-l3-w3", "target": "staubsaugen", "native": "vysávat", "note": "Doslova „prach sát“. Ich sauge Staub i ich staubsauge; čte se [ŠTAUP-zau-gen]", "reviewed": false },
        { "id": "u18-l3-w4", "target": "bügeln", "native": "žehlit", "note": "ü jako i se zaokrouhlenými rty: [BÜ-geln]", "reviewed": false },
