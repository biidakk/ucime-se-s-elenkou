    {
      "id": "u18-l2",
      "title": "Pocity",
      "titleTarget": "Gefühle",
      "reviewed": false,
      "tip": {
        "title": "Ich freue mich auf …",
        "text": "Mnoho sloves o pocitech je zvratných v obou jazycích: sich freuen = těšit se, sich ärgern = zlobit se, sich fühlen = cítit se. Často za nimi stojí předložka a po ní 4. pád: sich freuen auf (těšit se na), sich interessieren für (zajímat se o), sich erinnern an (vzpomínat na), sich ärgern über (zlobit se kvůli). Předložka se často liší od češtiny, učte se ji proto spolu se slovesem. A pozor, někdy je to naopak: česky „bojím se“, německy bez sich: Ich habe Angst (mám strach).",
        "examples": [
          { "target": "Ich freue mich auf das Wochenende.", "native": "Těším se na víkend." },
          { "target": "Ich interessiere mich für Musik.", "native": "Zajímám se o hudbu." },
          { "target": "Erinnern Sie sich an den Film?", "native": "Vzpomínáte si na ten film?" }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u18-l2-w1", "target": "sich freuen", "native": "těšit se; mít radost", "note": "sich freuen auf = těšit se na; čte se [FROJ-en]", "reviewed": false },
        { "id": "u18-l2-w2", "target": "sich ärgern", "native": "zlobit se", "note": "sich ärgern über = zlobit se kvůli; ä = e: [ER-gern]", "reviewed": false },
        { "id": "u18-l2-w3", "target": "sich interessieren", "native": "zajímat se", "note": "Pozor: für, ne „o“: sich interessieren für. Přízvuk: [in-te-re-SÍ-ren]", "reviewed": false },
        { "id": "u18-l2-w4", "target": "sich erinnern", "native": "vzpomenout si; pamatovat si", "note": "sich erinnern an = vzpomínat na; přízvuk: [er-I-nern]", "reviewed": false },
        { "id": "u18-l2-w5", "target": "sich ausruhen", "native": "odpočinout si", "note": "Předpona jde na konec: Ich ruhe mich aus. h se nečte: [AUS-rú-en]", "reviewed": false },
