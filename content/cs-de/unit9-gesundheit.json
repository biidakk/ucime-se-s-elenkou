    {
      "id": "u9-l3",
      "title": "V lékárně",
      "titleTarget": "In der Apotheke",
      "reviewed": false,
      "tip": {
        "title": "Nehmen Sie …!",
        "text": "Když Vám lékař nebo lékárník radí, použije rozkaz s „Sie“: sloveso jde na začátek a hned za ním Sie. Česky stačí jedno slovo „Berte“, německy řeknete „Nehmen Sie“ – Sie nikdy nevynechávejte. Slova jsou stejná jako v otázce, rozdíl je jen v tónu a ve znaménku na konci: Nehmen Sie Tabletten? (Berete prášky?) – Nehmen Sie täglich zwei Tabletten! (Berte denně dva prášky!)",
        "examples": [
          { "target": "Nehmen Sie täglich zwei Tabletten.", "native": "Berte denně dva prášky." },
          { "target": "Trinken Sie viel Tee!", "native": "Pijte hodně čaje!" },
          { "target": "Gute Besserung!", "native": "Brzy se uzdravte!" }
        ],
        "reviewed": false
      },
      "words": [
