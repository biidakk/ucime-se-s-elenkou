      "tip": {
        "title": "Hand → Hände",
        "text": "Podobně jako česky dům → domy se i v němčině v množném čísle často mění samohláska: a → ä, o → ö, u → ü, au → äu. Die Hand → die Hände, der Zahn → die Zähne, der Kopf → die Köpfe, der Bauch → die Bäuche. Tečky nevynechávejte, mění výslovnost: ä se čte jako e (Hände ≈ „HEN-de“, Zähne ≈ „CÉ-ne“), äu jako oj, ö řekněte jako e se zaokrouhlenými rty. Pozor: der Rücken (záda) je německy jednotné číslo.",
        "examples": [
          { "target": "Ich habe zwei Hände.", "native": "Mám dvě ruce." },
          { "target": "Das Kind hat schon zwei Zähne.", "native": "To dítě už má dva zuby." },
          { "target": "Ich habe zwei Arme und zwei Beine.", "native": "Mám dvě paže a dvě nohy." }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u9-l1-w1", "target": "der Kopf", "native": "hlava", "note": "Pozor, mužský rod; množné číslo: die Köpfe", "reviewed": false },
        { "id": "u9-l1-w2", "target": "der Bauch", "native": "břicho", "note": "ch po au se čte jako české ch; množné číslo: die Bäuche", "reviewed": false },
        { "id": "u9-l1-w3", "target": "der Rücken", "native": "záda", "note": "Německy jednotné číslo: der Rücken = ta záda; množné číslo: die Rücken", "reviewed": false },
