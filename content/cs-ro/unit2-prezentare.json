      "tip": {
        "title": "Jmenuji se… a 5. pád",
        "text": "„Jmenuji se“ se řekne „mă numesc“ – i se zvratným slůvkem jako v češtině (mă ≈ se). V hovoru uslyšíte i „mă cheamă“, doslova „volá mě“. A dobrá zpráva: rumunština má 5. pád (oslovení) stejně jako čeština. Z „domn“ (pán) je „Domnule!“ (Pane!), z „Ion“ je „Ioane!“ (jako Jan → Jene!). Paní oslovíte „Doamnă!“.",
        "examples": [
          { "target": "Mă numesc Ana.", "native": "Jmenuji se Ana. – čte se „mă nu-MESK“" },
          { "target": "Cum vă numiți, doamnă?", "native": "Jak se jmenujete, paní?" },
          { "target": "Ioane, ce mai faci?", "native": "Jene, jak se máš? – 5. pád jako v češtině" }
        ],
        "reviewed": false
      },
