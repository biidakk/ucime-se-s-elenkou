          { "target": "Sunt la poștă.", "native": "Jsem na poště." },
          { "target": "Merg la gară.", "native": "Jdu na nádraží." },
          { "target": "Sunt în oraș.", "native": "Jsem ve městě." }
        ],
        "reviewed": false
