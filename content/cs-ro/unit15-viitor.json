        { "id": "u15-l1-w4", "target": "anul viitor", "native": "příští rok", "note": "anul = ten rok (un an). Čte se „A-nul vi-i-TOR“.", "reviewed": false },
        { "id": "u15-l1-w5", "target": "deseară", "native": "dnes večer", "note": "Čte se „de-SEA-ră“, ea je jedna slabika. Srovnejte: aseară = včera večer.", "reviewed": false },
