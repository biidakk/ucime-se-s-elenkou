    {
      "id": "u21-l2",
      "title": "Cumpăr mere, îmi plac câinii",
      "titleTarget": "Kupuju jablka",
      "reviewed": false,
      "tip": {
        "title": "Pluralul aproape nu se schimbă",
        "text": "În română spui „Cumpăr mere”: pluralul rămâne la fel după verb. În cehă e la fel pentru lucruri și pentru cuvintele feminine: jablka → Kupuju jablka, kočky → Mám ráda kočky. Doar ființele masculine își schimbă pluralul: psi → Mám ráda psy, bratři → Mám dva bratry, kamarádi → Čekám na kamarády.",
        "examples": [
          {
            "target": "Kupuju jablka.",
            "native": "Cumpăr mere."
          },
          {
            "target": "Mám ráda psy.",
            "native": "Îmi plac câinii."
          },
          {
            "target": "Mám dva bratry.",
            "native": "Am doi frați."
          }
        ],
        "reviewed": false
