    {
      "id": "u18-l3",
      "title": "Gata!",
      "titleTarget": "Hotovo!",
      "reviewed": false,
      "tip": {
        "title": "Prefixele care termină treaba",
        "text": "Ai întâlnit deja o pereche: Zaplatím, prosím (unitatea 4) vine de la zaplatit, „a plăti până la capăt”. Multe perechi se fac cu un prefix: platit → zaplatit, vařit → uvařit, pít → vypít, jíst → sníst, učit se → naučit se. În română „am mâncat” poate fi și „am mâncat ceva”, și „am mâncat tot”. În cehă, snědla jsem înseamnă clar „am mâncat tot”.",
        "examples": [
          {
            "target": "Uvařila jsem oběd.",
            "native": "Am gătit prânzul (e gata)."
          },
          {
            "target": "Už jsem to snědla.",
            "native": "Am mâncat deja tot."
          },
          {
            "target": "Naučila jsem se nové slovo.",
            "native": "Am învățat un cuvânt nou."
          }
        ],
        "reviewed": false
      },
