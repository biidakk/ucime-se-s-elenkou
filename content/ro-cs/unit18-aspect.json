    {
      "id": "u18-l2",
      "title": "O să cumpăr",
      "titleTarget": "Koupím to",
      "reviewed": false,
      "tip": {
        "title": "Prezentul care înseamnă viitor",
        "text": "Iată trucul: verbul „de rezultat” pus la prezent înseamnă viitor. Koupím = o să cumpăr, udělám = o să fac, zavolám = o să sun. Pentru ce faci acum sau de obicei folosești verbul „de proces”: kupuju = cumpăr. Și niciodată „budu koupit”: budu merge doar cu verbele de proces.",
        "examples": [
          {
            "target": "Kupuju chleba každý den.",
            "native": "Cumpăr pâine în fiecare zi."
          },
          {
            "target": "Zítra koupím chleba.",
            "native": "Mâine o să cumpăr pâine."
          },
          {
            "target": "Hned to udělám.",
            "native": "O fac imediat."
          }
        ],
        "reviewed": false
      },
