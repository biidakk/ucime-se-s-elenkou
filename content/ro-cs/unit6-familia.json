    {
      "id": "u6-l3",
      "title": "Bunici, unchi și mătuși",
      "titleTarget": "Babička a dědeček",
      "reviewed": false,
      "tip": {
        "title": "Diminutive peste tot",
        "text": "Și românii, și cehii folosesc des diminutive: mamă → mămica, bunic → bunicuț. În cehă, bába → babička (bunica), děda → dědeček (bunicul), máma → maminka (mămica). Terminațiile -ička, -eček, -inka sunt ca „-uța”, „-ică” din română. Formele cu diminutiv sunt cele normale pentru bunici.",
        "examples": [
          {
            "target": "To je moje babička.",
            "native": "Ea e bunica mea."
          },
          {
            "target": "To je můj dědeček.",
            "native": "El e bunicul meu."
          },
          {
            "target": "Moje maminka je doma.",
            "native": "Mămica mea e acasă."
          }
        ],
        "reviewed": false
      },
