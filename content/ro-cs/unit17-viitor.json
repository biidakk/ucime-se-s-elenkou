    {
      "id": "u17-l1",
      "title": "Voi lucra",
      "titleTarget": "Budu pracovat",
      "reviewed": false,
      "tip": {
        "title": "„Voi + infinitiv” = budu + infinitiv",
        "text": "Româna face viitorul cu „voi”: voi lucra, vei lucra, va lucra. Ceha face exact la fel, cu budu: budu pracovat, budeš pracovat, bude pracovat, budeme, budete, budou. Singur, budu înseamnă „voi fi”: Budu doma = Voi fi acasă. Atenție: așa se formează viitorul doar la verbele „de proces” (pracovat, dělat, vařit). Despre celelalte vorbim în unitatea următoare.",
        "examples": [
          {
            "target": "Zítra budu pracovat.",
            "native": "Mâine voi lucra."
          },
          {
            "target": "Budeš doma?",
            "native": "Vei fi acasă?"
          },
          {
            "target": "V sobotu budeme vařit.",
            "native": "Sâmbătă vom găti."
          }
        ],
        "reviewed": false
      },
