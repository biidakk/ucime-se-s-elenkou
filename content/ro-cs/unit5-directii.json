    {
      "id": "u5-l2",
      "title": "Stânga, dreapta, înainte",
      "titleTarget": "Doleva, doprava",
      "reviewed": false,
      "tip": {
        "title": "Capcana cuvântului „drept”",
        "text": "În română „drept” înseamnă și „la dreapta”, și „înainte” („mergi drept”). Ceha le desparte clar: doprava = la dreapta, rovně = drept înainte. Dacă un ceh îți spune „rovně”, nu cotești nicăieri! Iar doleva = la stânga. „Do-” arată direcția, ca „la” din română.",
        "examples": [
          {
            "target": "Jděte rovně.",
            "native": "Mergeți drept înainte."
          },
          {
            "target": "Pak doprava.",
            "native": "Apoi la dreapta."
          },
          {
            "target": "Na rohu doleva.",
            "native": "La colț, la stânga."
          }
        ],
        "reviewed": false
