    {
      "id": "u12-l2",
      "title": "Anotimpurile",
      "titleTarget": "Roční období",
      "reviewed": false,
      "tip": {
        "title": "Vara = v létě",
        "text": "În română spui simplu „vara”, „iarna”. Ceha pune o prepoziție în față și schimbă terminația: léto → v létě (vara), zima → v zimě (iarna). Primăvara și toamna merg cu „na”: na jaře, na podzim. Și atenție: zima înseamnă și „iarnă”, și „frig”.",
        "examples": [
          {
            "target": "V létě je horko.",
            "native": "Vara e foarte cald."
          },
          {
            "target": "V zimě sněží.",
            "native": "Iarna ninge."
          },
          {
            "target": "Na podzim prší.",
            "native": "Toamna plouă."
          }
        ],
        "reviewed": false
      },
