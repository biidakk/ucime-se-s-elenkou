    {
      "id": "u12-l3",
      "title": "Lunile anului",
      "titleTarget": "Měsíce",
      "reviewed": false,
      "tip": {
        "title": "Luni cu nume din natură",
        "text": "Lunile românești vin din latină (ianuarie, februarie…), dar româna are și nume populare: Gerar, Florar, Cuptor, Brumar. Ceha folosește chiar astfel de nume: leden (de la led = gheață), květen (de la květ = floare, ca Florar), listopad (căderea frunzelor). Toate: leden, únor, březen, duben, květen, červen, červenec, srpen, září, říjen, listopad, prosinec.",
        "examples": [
          {
            "target": "v lednu",
            "native": "în ianuarie"
          },
          {
            "target": "v květnu",
            "native": "în mai"
          },
          {
            "target": "Mám narozeniny v prosinci.",
            "native": "Îmi serbez ziua în decembrie."
          }
        ],
        "reviewed": false
      },
