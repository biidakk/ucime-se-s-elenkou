    {
      "id": "u19-l2",
      "title": "La bunica, fără zahăr",
      "titleTarget": "U babičky, bez cukru",
      "reviewed": false,
      "tip": {
        "title": "u, bez, od: tot genitiv",
        "text": "Încă trei cuvinte mici cer genitivul. u = la cineva (acasă la el sau la cabinetul lui): u babičky = la bunica, u doktora = la doctor. bez = fără: bez cukru = fără zahăr. od = de la cineva: dárek od manžela = un cadou de la soț. Româna spune „la” și pentru „sunt la bunica”, și pentru „merg la bunica”; ceha folosește u doar când ești deja acolo.",
        "examples": [
          {
            "target": "V neděli jsem u babičky.",
            "native": "Duminică sunt la bunica."
          },
          {
            "target": "Čaj bez cukru, prosím.",
            "native": "Un ceai fără zahăr, vă rog."
          },
          {
            "target": "To je dopis od mámy.",
            "native": "E o scrisoare de la mama."
          }
        ],
        "reviewed": false
      },
