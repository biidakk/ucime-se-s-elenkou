      "reviewed": false,
      "tip": {
        "title": "Cum citești ě",
        "text": "ě nu e o vocală nouă, ci un „e” care înmoaie litera dinainte. După p, b, v, f se citește „ie”, ca în „fier” sau „piept”: pět = „piet”, devět = „deviet”. După d, t, n, litera devine moale: dě = „die” rostit scurt. Bonus: sedm și osm se citesc „sedum” și „osum”.",
        "examples": [
          {
            "target": "devět",
            "native": "nouă – „deviet”"
          },
          {
            "target": "sedm",
            "native": "șapte – „sedum”"
          },
          {
            "target": "osm",
            "native": "opt – „osum”"
          }
        ],
        "reviewed": false
      },
