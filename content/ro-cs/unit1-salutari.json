    {
      "id": "u1-l4",
      "title": "Sunete pe care le știi deja",
      "titleTarget": "Čaj a čokoláda",
      "reviewed": false,
      "tip": {
        "title": "Ceha are „ș” și „ț” – doar se scriu altfel",
        "text": "Unde româna pune sedilă (ș, ț), ceha pune un „cârlig” numit háček. Sunetele sunt aproape aceleași: š = ș, ž = j, č = ce/ci din „ceai”. Atenție la litera c: în cehă se citește MEREU ț, deci „cukr” (zahăr) se citește „țucr”. Iar ch este un h aspru, ca la finalul cuvântului „duh”, dar mai apăsat.",
        "examples": [
          {
            "target": "šunka",
            "native": "șuncă – š = ș"
          },
          {
            "target": "čaj",
            "native": "ceai – č = ce/ci"
          },
          {
            "target": "cukr",
            "native": "zahăr – se citește „țucr”"
          },
          {
            "target": "chleba",
            "native": "pâine – ch = h aspru"
          }
        ],
        "reviewed": false
      },
