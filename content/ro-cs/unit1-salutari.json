    {
      "id": "u1-l3",
      "title": "Ce mai faci?",
      "titleTarget": "Jak se máš?",
      "reviewed": false,
      "tip": {
        "title": "Tu și dumneavoastră: ty și vy",
        "text": "Ca în română, ceha are o formă pentru „tu” (ty) și una politicoasă (vy). Și la fel ca în „dumneavoastră aveți”, forma politicoasă folosește verbul la plural: „Jak se máš?” (tu) – „Jak se máte?” (dumneavoastră). Bonus: „Jak se máš?” înseamnă literal „Cum te ai?” – „se” e un pronume reflexiv, ca „te”/„se” din română.",
        "examples": [
          {
            "target": "Jak se máš?",
            "native": "Ce mai faci? (tu)"
          },
          {
            "target": "Jak se máte?",
            "native": "Ce mai faceți? (dumneavoastră)"
          }
        ],
        "reviewed": false
      },
