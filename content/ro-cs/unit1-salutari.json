    {
      "id": "u1-l1",
      "title": "Bună ziua și la revedere",
      "titleTarget": "Dobrý den!",
      "reviewed": false,
      "tip": {
        "title": "Accentul: mereu pe prima silabă",
        "text": "În română accentul se mută de la un cuvânt la altul (casă, cafea). În cehă regula e simplă și fără excepții: accentul cade ÎNTOTDEAUNA pe prima silabă. DO-brý den, DO-brou noc. Atenție: liniuța de pe vocale (á, é, í, ó, ú, ý) NU arată accentul, ci că vocala se pronunță mai lung.",
        "examples": [
          {
            "target": "Dobrý den",
            "native": "DO-brý den (accent pe „do”, „ý” lung)"
          },
          {
            "target": "Na shledanou",
            "native": "NA-shle-da-nou (prepoziția „na” ia accentul)"
          }
        ],
        "reviewed": false
      },
