    {
      "id": "u4-l3",
      "title": "La restaurant",
      "titleTarget": "V restauraci",
      "reviewed": false,
      "tip": {
        "title": "Cuvinte slave pe care le știi deja",
        "text": "Româna a împrumutat sute de cuvinte slave, așa că multe cuvinte cehe îți sună cunoscut: zdraví (sănătate) – ca „zdravăn”, přítel (prieten) – „prieten”. Atenție la prietenii falși: drahý înseamnă mai ales „scump”, čas înseamnă „timp” (nu „ceas”), iar nevěsta e „mireasă”, nu „nevastă”. „Na zdraví!” = „Noroc!”, literal „pentru sănătate”.",
        "examples": [
          {
            "target": "Na zdraví!",
            "native": "Noroc! (zdraví ~ zdravăn)"
          },
          {
            "target": "To je drahé.",
            "native": "E scump. (nu „drag”!)"
          },
          {
            "target": "Nemám čas.",
            "native": "N-am timp. (nu „ceas”!)"
          }
        ],
        "reviewed": false
      },
