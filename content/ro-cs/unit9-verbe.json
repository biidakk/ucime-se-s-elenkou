    {
      "id": "u9-l1",
      "title": "Verbele în -ám",
      "titleTarget": "Dělám, znám, čekám",
      "reviewed": false,
      "tip": {
        "title": "Terminația spune cine face",
        "text": "În română spui „fac”, „faci”, „face” și nu mai ai nevoie de „eu” sau „tu”: terminația arată persoana. Ceha face exact la fel. Verbele ca dělat (a face) au terminațiile: dělám (fac), děláš (faci), dělá (face), děláme (facem), děláte (faceți), dělají (fac ei). Pronumele já, ty se pun doar pentru accent.",
        "examples": [
          {
            "target": "Co děláš?",
            "native": "Ce faci?"
          },
          {
            "target": "Dělám kávu.",
            "native": "Fac cafea."
          },
          {
            "target": "Znáš Petra?",
            "native": "Îl cunoști pe Petr?"
          }
        ],
        "reviewed": false
      },
