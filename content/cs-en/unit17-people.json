      "tip": {
        "title": "Slowly, well: jak něco děláte",
        "text": "Jak něco děláte, řeknete příslovcem. Většinou stačí přidat -ly: slow → slowly, careful → carefully. Výjimky: good → well, fast → fast, hard → hard. Příslovce stojí až za tím, co děláte: She speaks English well. Neříkejte She speaks well English. Česky je slovosled volný, anglicky sloveso a jeho předmět drží pohromadě.",
        "examples": [
          { "target": "Please speak slowly.", "native": "Mluvte prosím pomalu." },
          { "target": "She speaks English well.", "native": "Mluví dobře anglicky." },
          { "target": "He drives carefully.", "native": "Jezdí opatrně." },
          { "target": "They work hard.", "native": "Tvrdě pracují." }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u17-l3-w1", "target": "slowly", "native": "pomalu", "note": "slow = pomalý. Čte se „SLOU-li“.", "reviewed": false },
