      "tip": {
        "title": "Nabídka a slib: I'll…",
        "text": "Will (zkráceně 'll) použijte, když se rozhodnete právě teď, když něco nabízíte nebo slibujete: I'll help you. I'll carry your bag. A také když odhadujete, co bude: It will probably rain. Will má pro všechny osoby stejný tvar, sloveso za ním je bez to a bez -s. Zápor je won't. Probably stojí za will, ale před won't: It probably won't rain. Česky tomu odpovídá obyčejný budoucí čas: pomůžu, ponesu.",
        "examples": [
          { "target": "I'll carry your bag.", "native": "Ponesu vám tašku." },
          { "target": "I promise I won't forget.", "native": "Slibuji, že nezapomenu." },
          { "target": "It will probably rain tomorrow.", "native": "Zítra asi bude pršet." },
          { "target": "Maybe I'll go for a walk.", "native": "Možná půjdu na procházku." }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u16-l3-w1", "target": "will", "native": "budu; bude", "note": "Budoucnost, pro všechny stejně: I will, she will. Zkráceně I'll.", "reviewed": false },
        { "id": "u16-l3-w2", "target": "won't", "native": "nebudu; nebude", "note": "Zkratka will not. Čte se „wount“, jinak než want.", "reviewed": false },
