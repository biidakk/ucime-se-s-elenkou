          { "target": "I was tired yesterday.", "native": "Včera jsem byla unavená." },
          { "target": "We were at home last night.", "native": "Včera večer jsme byli doma." },
          { "target": "Was he ill? – Yes, he was.", "native": "Byl nemocný? – Ano." },
          { "target": "I was born in nineteen fifty-five.", "native": "Narodil jsem se v roce 1955." }
        ],
