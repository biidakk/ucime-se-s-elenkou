      "tip": {
        "title": "Cheaper than…",
        "text": "Krátká přídavná jména přidají -er: cheap → cheaper, long → longer, old → older. Pozor na pravopis: big → bigger, hot → hotter. Dlouhá slova dostanou more: expensive → more expensive. Česky je „dražší“ jedno slovo, anglicky dvě. Ale nikdy obojí: ne more cheaper. „Než“ se řekne than: This coat is cheaper than that coat.",
        "examples": [
          { "target": "This dress is cheaper.", "native": "Tyhle šaty jsou levnější." },
          { "target": "These shoes are more expensive than those.", "native": "Tyhle boty jsou dražší než tamty." },
          { "target": "Have you got a bigger size?", "native": "Máte větší velikost?" },
          { "target": "Can I try it on?", "native": "Můžu si to zkusit?" }
        ],
        "reviewed": false
      },
      "words": [
