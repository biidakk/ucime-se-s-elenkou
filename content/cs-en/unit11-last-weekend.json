    {
      "id": "u11-l3",
      "title": "Co jste dělali?",
      "titleTarget": "What did you do?",
      "reviewed": false,
      "tip": {
        "title": "Otázka s did",
        "text": "Česky stačí změnit melodii věty: Šli jste? Anglicky musí otázka v minulém čase mít did: Did you go? Where did you go? Did už nese minulost, proto je sloveso v základním tvaru: go, ne went. Neříkejte Where you went? ani Where did you went? Zápor je stejný: didn't + základní tvar: We didn't go. Jen was a were did nepotřebují: Where were you?",
        "examples": [
          { "target": "Where did you go?", "native": "Kam jste jeli?" },
          { "target": "Did you see the film? Yes, I did.", "native": "Viděli jste ten film? Ano." },
          { "target": "We didn't buy bread.", "native": "Nekoupili jsme chleba." },
          { "target": "Why did she call?", "native": "Proč volala?" }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u11-l3-w1", "target": "did", "native": "otázka v minulém čase", "note": "Did you go? = Šli jste? Po did je sloveso v základním tvaru.", "reviewed": false },
        { "id": "u11-l3-w2", "target": "didn't", "native": "zápor v minulém čase", "note": "We didn't go. = Nešli jsme. Celý tvar: did not.", "reviewed": false },
