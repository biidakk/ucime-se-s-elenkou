      "tip": {
        "title": "Minulý čas: -ed",
        "text": "U pravidelných sloves stačí přidat -ed: visit → visited, clean → cleaned. Tvar je stejný pro všechny osoby: I, she, we, they cleaned. Česky „uklízela“ i „uklidila“, anglicky obojí cleaned. Pozor na výslovnost, -ed se čte třemi způsoby. Po t a d jako „id“: wanted, needed. Po k, p, s, š a č jen jako „t“: cooked, helped, watched. Jinak jen jako „d“: cleaned, stayed. Nikdy neříkejte „klíned“.",
        "examples": [
          { "target": "We visited our daughter.", "native": "Navštívili jsme naši dceru." },
          { "target": "She cleaned the kitchen.", "native": "Uklidila kuchyň." },
          { "target": "My son wanted a coffee.", "native": "Můj syn chtěl kávu." },
          { "target": "We cooked chicken.", "native": "Vařili jsme kuře." }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u11-l1-w1", "target": "visit", "native": "navštívit", "note": "visited, čte se „vi-zi-tid“.", "reviewed": false },
