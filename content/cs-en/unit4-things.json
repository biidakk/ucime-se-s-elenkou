    {
      "id": "u4-l2",
      "title": "Tohle a tamto",
      "titleTarget": "This and that",
      "reviewed": false,
      "tip": {
        "title": "This, that a množné číslo",
        "text": "This (tohle) je blízko, that (tamto) je dál. Pro více věcí: these (tyhle) a those (tamty). Množné číslo se většinou tvoří koncovkou -s: a key → keys, a bag → bags. Pozor na výjimky: man → men, woman → women a místo persons se říká people (lidé). Glasses (brýle) jsou vždy v množném čísle, jako česky: These are my glasses.",
        "examples": [
          { "target": "This is my bag.", "native": "Tohle je moje taška." },
          { "target": "That man is my husband.", "native": "Tamten muž je můj manžel." },
          { "target": "These are my glasses.", "native": "Tohle jsou moje brýle." }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u4-l2-w1", "target": "this", "native": "tohle", "note": "O jedné věci blízko. Také tento, tato.", "reviewed": false },
        { "id": "u4-l2-w2", "target": "that", "native": "tamto", "note": "O jedné věci dál. Také tamten, tamta.", "reviewed": false },
        { "id": "u4-l2-w3", "target": "these", "native": "tyhle", "note": "Množné číslo od this.", "reviewed": false },
        { "id": "u4-l2-w4", "target": "those", "native": "tamty", "note": "Množné číslo od that.", "reviewed": false },
        { "id": "u4-l2-w5", "target": "man", "native": "muž", "note": "Množné číslo men.", "reviewed": false },
        { "id": "u4-l2-w6", "target": "woman", "native": "žena", "note": "Množné číslo women. Čte se „wu-men“, v množném „wi-min“.", "reviewed": false },
        { "id": "u4-l2-w7", "target": "people", "native": "lidé", "note": "Už je to množné číslo: people are… Čte se „pí-pl“.", "reviewed": false },
        { "id": "u4-l2-w8", "target": "glasses", "native": "brýle", "note": "Vždy množné číslo: my glasses are… Také sklenice.", "reviewed": false }
