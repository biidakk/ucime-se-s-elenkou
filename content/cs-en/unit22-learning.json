      "title": "Velké rozhodnutí",
      "titleTarget": "A big decision",
      "reviewed": false,
      "tip": {
        "title": "Decide to, ale enjoy -ing",
        "text": "Po decide, hope a manage stojí to + sloveso: We decided to stay. Po enjoy, avoid a mind stojí sloveso s -ing: I enjoy reading. Neříkejte I enjoy to read. Nedá se to odvodit, učte se to u každého slovesa. U stop a remember se mění význam. She stopped eating meat. (Přestala jíst maso.) She stopped to eat. (Zastavila se, aby se najedla.) Remember to ring Mum. (Nezapomeňte zavolat mámě.) We remember meeting him. (Pamatujeme si, jak jsme ho potkali.)",
        "examples": [
          { "target": "We decided to stay at home.", "native": "Rozhodli jsme se zůstat doma." },
          { "target": "I enjoy reading.", "native": "Baví mě číst." },
          { "target": "She stopped eating meat.", "native": "Přestala jíst maso." },
          { "target": "Remember to ring Mum.", "native": "Nezapomeňte zavolat mámě." }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u22-l3-w1", "target": "decide", "native": "rozhodnout se", "note": "+ to: We decided to stay. Čte se „di-SAJD“.", "reviewed": false },
        { "id": "u22-l3-w2", "target": "enjoy", "native": "užívat si; bavit", "note": "+ -ing: I enjoy cooking. = Baví mě vařit. Čte se „in-DŽOJ“.", "reviewed": false },
        { "id": "u22-l3-w3", "target": "hope", "native": "doufat", "note": "+ to: We hope to see you soon. Čte se „houp“.", "reviewed": false },
        { "id": "u22-l3-w4", "target": "manage", "native": "zvládnout; podařit se", "note": "We managed to find it. = Podařilo se nám to najít. Čte se „menidž“.", "reviewed": false },
        { "id": "u22-l3-w5", "target": "avoid", "native": "vyhýbat se", "note": "+ -ing: avoid driving at night. Čte se „e-VOJD“.", "reviewed": false },
        { "id": "u22-l3-w6", "target": "remember", "native": "pamatovat si; nezapomenout", "note": "Remember to… = nezapomeňte; remember + -ing = pamatovat si, co se stalo. Čte se „ri-MEM-ba“.", "reviewed": false },
