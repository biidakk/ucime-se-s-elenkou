      "tip": {
        "title": "Po předložce sloveso s -ing",
        "text": "Když za předložkou (in, at, of, about) následuje sloveso, má v angličtině vždy -ing: I'm interested in learning English. She's good at speaking English. He's afraid of making mistakes. Česky tu je často infinitiv nebo „že…“. Neříkejte interested in to learn. Britský pravopis: practise se -s je sloveso (procvičovat), practice s -c je podstatné jméno (cvičení, praxe).",
        "examples": [
          { "target": "I'm interested in learning English.", "native": "Mám zájem učit se anglicky." },
          { "target": "She's good at speaking English.", "native": "Umí dobře mluvit anglicky." },
          { "target": "He's afraid of making mistakes.", "native": "Bojí se, že udělá chybu." },
          { "target": "We practise every day.", "native": "Cvičíme každý den." }
        ],
        "reviewed": false
      },
      "words": [
