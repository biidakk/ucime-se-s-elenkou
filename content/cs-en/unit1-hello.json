        { "id": "u1-l2-e2", "type": "choice", "prompt": "Vyberte správnou odpověď", "question": "Někdo vám poděkuje. Co odpovíte?", "questionLang": "native", "options": ["You're welcome.", "Please.", "Excuse me."], "answer": "You're welcome.", "reviewed": false },
