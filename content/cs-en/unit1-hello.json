    {
      "id": "u1-l2",
      "title": "Prosím a děkuji",
      "titleTarget": "Please and thank you",
      "reviewed": false,
      "tip": {
        "title": "Jedno české „prosím“, několik anglických slov",
        "text": "České „prosím“ má mnoho významů. Angličtina má pro každý jiné slovo. Když o něco žádáte, řekněte please. Když vám někdo poděkuje, odpovězte you're welcome. Když něco podáváte, řekněte here you are. Když jste něco neslyšeli, zeptejte se: Sorry? Angličané říkají please a thank you velmi často – u pokladny, v autobuse i doma.",
        "examples": [
          { "target": "A tea, please.", "native": "Jeden čaj, prosím." },
          { "target": "Thank you! – You're welcome.", "native": "Děkuji! – Prosím. (Není zač.)" },
          { "target": "Here you are.", "native": "Prosím. (Tady máte.)" },
          { "target": "Sorry?", "native": "Prosím? (Když jste něco neslyšeli.)" }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u1-l2-w1", "target": "please", "native": "prosím", "note": "Když o něco žádáte: A tea, please.", "reviewed": false },
        { "id": "u1-l2-w2", "target": "thank you", "native": "děkuji", "reviewed": false },
        { "id": "u1-l2-w3", "target": "thanks", "native": "díky", "note": "Méně formální než thank you.", "reviewed": false },
        { "id": "u1-l2-w4", "target": "you're welcome", "native": "není zač", "note": "Odpověď na thank you (česky také „prosím“).", "reviewed": false },
        { "id": "u1-l2-w5", "target": "sorry", "native": "promiňte; omlouvám se", "note": "Tázavě Sorry? = Prosím? (když jste neslyšeli).", "reviewed": false },
        { "id": "u1-l2-w6", "target": "excuse me", "native": "s dovolením", "note": "Když chcete projít nebo někoho oslovit (česky také „promiňte“).", "reviewed": false },
        { "id": "u1-l2-w7", "target": "yes", "native": "ano", "reviewed": false },
        { "id": "u1-l2-w8", "target": "no", "native": "ne", "note": "Pozor: české hovorové „no“ (= ano) se anglicky řekne yes.", "reviewed": false },
        { "id": "u1-l2-w9", "target": "here you are", "native": "tady máte", "note": "Když něco podáváte (česky často „prosím“).", "reviewed": false }
      ],
      "exercises": [
