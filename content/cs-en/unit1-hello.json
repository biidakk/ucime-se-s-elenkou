    {
      "id": "u1-l3",
      "title": "Jak se jmenujete?",
      "titleTarget": "What's your name?",
      "reviewed": false,
      "tip": {
        "title": "Vždy řekněte „I“",
        "text": "Česky stačí říct „Jsem Eva“. Anglicky musíte vždy říct, kdo: I am Eva. Slovo I (já) se píše vždy velkým písmenem. V hovoru se zkracuje: I am → I'm, you are → you're. A ještě jedna dobrá zpráva: you znamená „ty“ i „vy“. Angličtina vykání nezná, zdvořilost vyjádříte slovy please a thank you a přátelským tónem.",
        "examples": [
          { "target": "I'm Eva.", "native": "Jsem Eva." },
          { "target": "My name is Eva.", "native": "Jmenuji se Eva." },
          { "target": "How are you? – I'm fine, thanks.", "native": "Jak se máte? – Mám se dobře, díky." }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u1-l3-w1", "target": "I am", "native": "já jsem", "note": "Zkráceně I'm. I se píše vždy velké.", "reviewed": false },
        { "id": "u1-l3-w2", "target": "you are", "native": "ty jsi; vy jste", "note": "Zkráceně you're.", "reviewed": false },
        { "id": "u1-l3-w3", "target": "my name is", "native": "jmenuji se", "note": "Doslova „moje jméno je“.", "reviewed": false },
        { "id": "u1-l3-w4", "target": "What's your name?", "native": "Jak se jmenujete?", "note": "What's = What is. Platí i pro „Jak se jmenuješ?“.", "reviewed": false },
        { "id": "u1-l3-w5", "target": "Nice to meet you.", "native": "Těší mě.", "note": "Při seznámení.", "reviewed": false },
        { "id": "u1-l3-w6", "target": "How are you?", "native": "Jak se máte?", "note": "Platí i pro „Jak se máš?“.", "reviewed": false },
        { "id": "u1-l3-w7", "target": "I'm fine.", "native": "Mám se dobře.", "note": "Často: I'm fine, thanks.", "reviewed": false },
        { "id": "u1-l3-w8", "target": "And you?", "native": "A vy?", "note": "Platí i pro „A ty?“.", "reviewed": false }
      ],
