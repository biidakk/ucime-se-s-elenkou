      "title": "Dobrý den a na shledanou",
      "titleTarget": "Hello and goodbye",
      "reviewed": false,
      "tip": {
        "title": "Hello, nebo hi?",
        "text": "Hello se hodí vždy a ke každému – k sousedce, v obchodě i u lékaře. Hi je přátelské „ahoj“ pro známé. Podle denní doby můžete říct good morning (do poledne), good afternoon (odpoledne) a good evening (večer). Pozor: good night neznamená „dobrý večer“. Říká se jen na rozloučenou večer nebo před spaním, stejně jako naše „dobrou noc“.",
        "examples": [
          { "target": "Good morning!", "native": "Dobré ráno! (dopoledne také „Dobrý den!“)" },
          { "target": "Good evening!", "native": "Dobrý večer! (při příchodu)" },
          { "target": "Goodbye, good night!", "native": "Na shledanou, dobrou noc! (při odchodu)" }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u1-l1-w1", "target": "hello", "native": "dobrý den", "note": "Hodí se vždy a ke každému, i mezi přáteli.", "reviewed": false },
        { "id": "u1-l1-w2", "target": "hi", "native": "ahoj", "note": "Neformální, při setkání se známými.", "reviewed": false },
        { "id": "u1-l1-w3", "target": "good morning", "native": "dobré ráno", "note": "Říká se až do poledne, i tam, kde Čech řekne „dobrý den“.", "reviewed": false },
        { "id": "u1-l1-w4", "target": "good afternoon", "native": "dobré odpoledne", "note": "Česky spíš „dobrý den“; v angličtině je to běžný pozdrav.", "reviewed": false },
        { "id": "u1-l1-w5", "target": "good evening", "native": "dobrý večer", "note": "Pozdrav při příchodu večer.", "reviewed": false },
        { "id": "u1-l1-w6", "target": "good night", "native": "dobrou noc", "note": "Jen na rozloučenou nebo před spaním, nikdy při příchodu.", "reviewed": false },
        { "id": "u1-l1-w7", "target": "goodbye", "native": "na shledanou", "reviewed": false },
