        { "id": "u2-l1-w3", "target": "it", "native": "ono; to", "note": "Pro věci, zvířata a místa (stůl, kniha, Londýn – vždy it).", "reviewed": false },
        { "id": "u2-l1-w4", "target": "we", "native": "my", "note": "We are = my jsme, zkráceně we're.", "reviewed": false },
