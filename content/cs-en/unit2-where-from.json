      "tip": {
        "title": "Vždy řekněte, kdo – i u věcí",
        "text": "Česky stačí říct „Je z Brna.“ Anglicky musíte vždy říct, kdo: He is from Brno (on), She is from Brno (ona). Pro věci, zvířata a místa se říká it, nikdy he ani she. Pro více lidí: we are (my jsme), they are (oni jsou). V hovoru se tvary zkracují: he's, she's, it's, we're, they're.",
        "examples": [
          { "target": "This is Petr. He's from Brno.", "native": "To je Petr. Je z Brna." },
          { "target": "Where is London? – It's in England.", "native": "Kde je Londýn? – Je v Anglii." },
          { "target": "We're from Prague.", "native": "Jsme z Prahy." }
        ],
        "reviewed": false
      },
      "words": [
        { "id": "u2-l1-w1", "target": "he", "native": "on", "note": "Jen o muži nebo chlapci. Zkráceně he's = he is.", "reviewed": false },
