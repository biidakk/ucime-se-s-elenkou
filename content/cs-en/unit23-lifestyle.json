        "examples": [
          { "target": "He gave up smoking ten years ago.", "native": "Před deseti lety přestal kouřit." },
          { "target": "We should cut down on sugar.", "native": "Měli bychom omezit cukr." },
          { "target": "She has taken up swimming.", "native": "Začala chodit plavat." },
